+def bastardloop_sample_response_headers(result):
+    """Serve original file formats and upstream sampler roots without conversion."""
+    suffix = pathlib.PurePosixPath(result["relativePath"]).suffix.lower()
+    headers = {"Content-Type": "audio/aiff" if suffix in {".aif", ".aiff"} else "audio/wav"}
+    if result["sourceKey"] == "samples_altbass":
+        folder = get_bastardloop_local_source_root("samples_altbass")
+        manifest = json.loads((folder / "manifest.json").read_text())
+        item = next((item for item in manifest["samples"] if item["name"] == result["relativePath"]), None)
+        if item is None:
+            raise ValueError("Bass sample is absent from the source manifest.")
+        headers["X-Mygrain-Source-Root"] = item["rootNote"]
+        headers["X-Mygrain-Source-Region"] = json.dumps({"start": item["sfzStartFrame"] / item["sampleRate"], "end": ((item["sfzEndFrame"] + 1) if item["sfzEndFrame"] is not None else item["frames"]) / item["sampleRate"]})
+    return headers
