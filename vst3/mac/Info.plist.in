<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>@MYGRAIN_BUNDLE_NAME@</string>
<key>CFBundleIdentifier</key><string>@MYGRAIN_BUNDLE_ID@</string>
<key>CFBundleName</key><string>@MYGRAIN_BUNDLE_NAME@</string>
<key>CFBundlePackageType</key><string>BNDL</string>
<key>CFBundleShortVersionString</key><string>@MYGRAIN_BUNDLE_VERSION@</string>
<key>CFBundleVersion</key><string>@MYGRAIN_BUNDLE_VERSION@</string>
<key>CFBundleSupportedPlatforms</key><array><string>MacOSX</string></array>
<key>LSMinimumSystemVersion</key><string>11.0</string>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
